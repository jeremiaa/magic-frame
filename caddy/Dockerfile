# Custom Caddy mit DNS-Provider-Plugins für ACME DNS-01 Challenge.
# Module: cloudflare + hetzner (matched die DDNS-Provider der App).
FROM caddy:2-builder AS builder

# DNS-Provider-Plugins für ACME DNS-01. Bewusst breit gewählt:
# Cloudflare + Hetzner matchen die DDNS-Provider; der Rest deckt die häufigsten
# europäischen + globalen Provider ab. Wer einen anderen Provider braucht, kann
# in der UI auf "Custom Caddyfile" wechseln und sein eigenes Caddyfile schreiben.
RUN xcaddy build \
    --with github.com/caddy-dns/cloudflare \
    --with github.com/caddy-dns/hetzner \
    --with github.com/caddy-dns/route53 \
    --with github.com/caddy-dns/digitalocean \
    --with github.com/caddy-dns/duckdns \
    --with github.com/caddy-dns/porkbun \
    --with github.com/caddy-dns/namecheap \
    --with github.com/caddy-dns/ionos \
    --with github.com/caddy-dns/netcup \
    --with github.com/caddy-dns/linode

FROM caddy:2
COPY --from=builder /usr/bin/caddy /usr/bin/caddy

# Default-Caddyfile außerhalb des /etc/caddy-Mounts ablegen — das Volume
# überschreibt sonst alles unter /etc/caddy beim ersten Start.
RUN mkdir -p /usr/share/caddy && \
    printf '%s\n' \
      '# Auto-generated default — Magic Frame schreibt das hier bei jeder Caddy-Config-Änderung neu.' \
      '{' \
      '    admin 0.0.0.0:2019' \
      '    auto_https off' \
      '}' \
      '' \
      ':80 {' \
      '    # header_up: sonst sieht die App keine Client-Adresse und verbucht' \
      '    # jeden Anmeldeversuch auf denselben Platzhalter — dann sperrt die' \
      '    # Sperre gegen Passwort-Raten den ganzen Haushalt statt des Angreifers.' \
      '    # {remote_host} ist die Gegenstelle, die Caddy tatsächlich angenommen' \
      '    # hat, also nicht durch einen mitgeschickten Header fälschbar.' \
      '    reverse_proxy app:3000 {' \
      '        header_up X-Real-IP {remote_host}' \
      '        header_up X-Forwarded-For {remote_host}' \
      '        header_up X-Forwarded-Proto {scheme}' \
      '    }' \
      '}' \
      > /usr/share/caddy/Caddyfile.default

# Beim Boot wird die Datei in DREI Fällen durch die Default-Variante ersetzt:
#   1. sie fehlt ganz (leeres Volume beim allerersten Start)
#   2. sie stammt noch aus dem Caddy-Basis-Image (kein "Auto-generated"-Marker)
#   3. sie ist eine ÄLTERE Ausgabe genau dieser Default-Variante
#
# Fall 3 ist neu und der Grund dafür: die Vorlage oben hat die drei header_up-
# Zeilen bekommen, ohne die die App keine Client-Adresse sieht. Die Bedingung
# prüfte aber nur auf "Auto-generated" — und das steht in der alten Datei auch
# drin. Bei jeder bestehenden Installation blieb die veraltete Datei also
# liegen, und die Reparatur kam nie an. Sie kam erst, wenn jemand zufällig
# einmal Einstellungen → Hosting speicherte.
#
# Unterschieden wird an der ersten Zeile, und das ist genau: die App schreibt
# "Auto-generated by Magic Frame", diese Vorlage schreibt "Auto-generated
# default". Eine von der App verwaltete Konfiguration — mit Domain, TLS und
# DNS-01 — trägt den ersten Marker und wird deshalb NIE angefasst. Nur eine
# unberührte Vorlage wird erneuert, und die enthält per Definition nichts,
# was jemand eingestellt hat.
ENTRYPOINT ["sh", "-c", "if [ ! -f /etc/caddy/Caddyfile ] || ! grep -q 'Auto-generated' /etc/caddy/Caddyfile 2>/dev/null || grep -q '^# Auto-generated default' /etc/caddy/Caddyfile 2>/dev/null; then cp /usr/share/caddy/Caddyfile.default /etc/caddy/Caddyfile; fi; exec caddy run --config /etc/caddy/Caddyfile --adapter caddyfile"]
